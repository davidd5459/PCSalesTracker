# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Neon Postgres connection string (Neon dashboard > Connect > "Pooled connection").
DATABASE_URL=

# IsThereAnyDeal API key (isthereanydeal.com > your apps).
ITAD_API_KEY=

# Where the frontend gets data: "sample" (generated, no backend needed) or "api" (the real database).
VITE_DATA_SOURCE=sample
